# Copy this file to .env and fill in real values for your machine.
# .env is git-ignored; .env.example is committed as documentation only.
# NEVER put real secrets in this file.

# --- PostgreSQL / Spring datasource ---
# These same variables are read by BOTH docker-compose.yml (to
# configure the PostgreSQL container) and application-dev.yml (to
# connect the application to it), so Compose and the app always agree.
# DB_PASSWORD has no default anywhere -- Compose fails fast with a
# clear error if it's missing, rather than silently starting an
# unprotected local database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commercecore
DB_USERNAME=commercecore
DB_PASSWORD=changeme_dev_only

# --- Phase 9 service databases / brokers ---
NOTIFICATION_DB_PORT=5433
NOTIFICATION_DB_NAME=notifications
NOTIFICATION_DB_USERNAME=notification
NOTIFICATION_DB_PASSWORD=changeme_notification_dev_only
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
CATALOG_CACHE_TTL=5m
OUTBOX_RETENTION=30d
CORE_PORT=8082
NOTIFICATION_PORT=8081
GATEWAY_PORT=8080
PROMETHEUS_PORT=9090
FRONTEND_PORT=3000
APP_DEMO_SEED=false

# --- Active Spring profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Phase 2 security ---
# Use a unique cryptographically random value of at least 32 bytes locally.
JWT_SIGNING_SECRET=replace_with_a_random_value_at_least_32_bytes_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=45m
MAXIMUM_FAILED_LOGINS=5
LOGIN_LOCK_DURATION=20m
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Phase 6 checkout/shipping (non-secret business configuration) ---
STANDARD_SHIPPING_FEE=5.00
STANDARD_DELIVERY_DAYS=5
EXPRESS_SHIPPING_FEE=15.00
EXPRESS_DELIVERY_DAYS=2
TAX_RATE_PERCENT=6.00
CHECKOUT_RESERVATION_TTL=15m
ORDER_EXPIRY_SCAN_INTERVAL=1m

# --- Email delivery ---
# Development mode writes raw delivery tokens only to the ignored build outbox.
# Production forces SMTP mode and requires the SMTP values below.
EMAIL_MODE=development
EMAIL_DEVELOPMENT_OUTBOX=build/dev-mail-outbox.txt
EMAIL_FROM=no-reply@localhost
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
